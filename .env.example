# ============================================================
# BTP AI Core FinOps Dashboard – Environment Variables
# ============================================================
# Copy this file to .env for local development:
#   cp .env.example .env
# Then fill in your actual values.
# NEVER commit .env to version control.
# ============================================================

# ── BTP Subaccount ────────────────────────────────────────────
# The UUID of the subaccount to monitor (from BTP cockpit URL)
SUBACCOUNT_ID=<your-subaccount-uuid>

# ── Spending limit & alert thresholds ─────────────────────────
# Monthly AI Core capacity unit budget
SPENDING_LIMIT=100

# Send a WARNING when usage reaches this % of the limit
WARNING_THRESHOLD_PERCENT=60

# Send an ALERT when usage reaches this % of the limit
ALERT_THRESHOLD_PERCENT=80

# ── UAS Reporting API ─────────────────────────────────────────
# OAuth2 credentials for the UAS Reporting API.
# On CF these come from VCAP_SERVICES automatically.
# For local dev, extract from a UAS service key.
UAS_CLIENT_ID=sb-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx!bXXXXX|uas-reporting!bXXX
UAS_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
UAS_TOKEN_URL=https://<global-account-id>.authentication.<region>.hana.ondemand.com/oauth/token
UAS_REPORTING_BASE_URL=https://uas-reporting.cfapps.<region>.hana.ondemand.com

# ── Encryption ────────────────────────────────────────────────
# Key used to encrypt sensitive fields (SMTP password) at rest.
# In production this is derived automatically from the XSUAA client secret.
# For local dev WITHOUT an XSUAA binding, set any random string here.
# If not set, passwords are stored in plain text (acceptable for local dev only).
ENCRYPTION_KEY=my-local-dev-secret-key-change-me

# ── SMTP email ────────────────────────────────────────────────
# Enable/disable SMTP email notifications
ENABLE_SMTP=true
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=monitor@yourcompany.com
SMTP_PASSWORD=your-smtp-app-password
SMTP_FROM=monitor@yourcompany.com

# Comma-separated list of recipient email addresses
NOTIFICATION_EMAIL=admin@example.com,team@example.com

# ── SAP Alert Notification Service (ANS) ─────────────────────
# In production, ANS credentials come from the CF service binding (MTA).
# No secrets are stored in the database.
# For LOCAL DEV ONLY (no CF binding available), set these env vars:
ENABLE_ANS=false
ANS_URL=https://clm-sl-ans-live-ans-service-api.cfapps.<region>.hana.ondemand.com
ANS_CLIENT_ID=sb-xxxxxxxx!bXXXX|ans-xsuaa!bXXX
ANS_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANS_TOKEN_URL=https://your-subaccount.authentication.<region>.hana.ondemand.com/oauth/token
